<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- playing in the background (PlaybackService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="EDIplayer"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.EDIplayer"
        android:enableOnBackInvokedCallback="true"
        android:hasCode="true">

        <!-- Portrait on phones; Android 16+ ignores this on large screens, where the
             UI uses its two-column layout. configChanges: the native UI handles
             rotation and resizing itself instead of the activity being recreated. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing">
            <meta-data android:name="android.app.lib_name" android:value="ediplayer" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
